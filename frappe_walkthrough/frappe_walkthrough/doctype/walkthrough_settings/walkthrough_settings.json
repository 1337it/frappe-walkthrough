 "fields": [
  {
   "fieldname": "tab_content",
   "fieldtype": "Tab Break",
   "label": "Content"
  },
  {
   "fieldname": "sb_load",
   "fieldtype": "Section Break",
   "label": "Walkthroughs"
  },
  {
   "fieldname": "status_html",
   "fieldtype": "HTML",
   "label": "Status"
  },
  {
   "fieldname": "load_walkthroughs",
   "fieldtype": "Button",
   "label": "Load walkthroughs",
   "description": "Builds walkthroughs for everything in scope and adds those your apps ship. Safe to run again: walkthroughs edited by hand are kept."
  },
  {
   "fieldname": "cb_load",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "import_form_tours",
   "fieldtype": "Button",
   "label": "Import Form Tours",
   "description": "Turns Frappe's own Form Tours into walkthroughs."
  },
  {
   "fieldname": "remove_generated",
   "fieldtype": "Button",
   "label": "Remove generated",
   "description": "Deletes generated walkthroughs that were not edited by hand."
  },
  {
   "fieldname": "sb_scope",
   "fieldtype": "Section Break",
   "label": "What to cover"
  },
  {
   "fieldname": "modules",
   "fieldtype": "Table MultiSelect",
   "label": "Modules",
   "options": "Walkthrough Settings Module",
   "description": "Leave empty for every module of your installed apps (Frappe and ERPNext core are added by the tick below)."
  },
  {
   "fieldname": "include_core",
   "fieldtype": "Check",
   "label": "Include Frappe and ERPNext core modules"
  },
  {
   "fieldname": "extra_doctypes",
   "fieldtype": "Table MultiSelect",
   "label": "Also cover these DocTypes",
   "options": "Walkthrough Settings DocType"
  },
  {
   "fieldname": "exclude_doctypes",
   "fieldtype": "Table MultiSelect",
   "label": "Never cover these DocTypes",
   "options": "Walkthrough Settings DocType"
  },
  {
   "fieldname": "no_create_doctypes",
   "fieldtype": "Table MultiSelect",
   "label": "No Create walkthrough for these",
   "options": "Walkthrough Settings DocType",
   "description": "Records the system writes, or that already have a hand-written Create walkthrough. They still get a Find-and-read one."
  },
  {
   "fieldname": "cb_scope",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "only_in_workspaces",
   "fieldtype": "Check",
   "label": "Only DocTypes and reports listed in a workspace",
   "default": "1",
   "description": "What people can actually reach from the sidebar. Untick to cover every DocType of the chosen modules."
  },
  {
   "fieldname": "include_create",
   "fieldtype": "Check",
   "label": "Create walkthroughs",
   "default": "1"
  },
  {
   "fieldname": "include_read",
   "fieldtype": "Check",
   "label": "Find-and-read walkthroughs",
   "default": "1"
  },
  {
   "fieldname": "include_reports",
   "fieldtype": "Check",
   "label": "Report walkthroughs",
   "default": "1"
  },
  {
   "fieldname": "max_inputs",
   "fieldtype": "Int",
   "label": "Fields to ask for in a Create walkthrough",
   "default": "6"
  },
  {
   "fieldname": "include_tour",
   "fieldtype": "Check",
   "label": "The \"Find your way around\" tour",
   "default": "1"
  },
  {
   "fieldname": "sb_lang",
   "fieldtype": "Section Break",
   "label": "Languages"
  },
  {
   "fieldname": "languages",
   "fieldtype": "Table MultiSelect",
   "label": "Languages",
   "options": "Walkthrough Settings Language",
   "description": "Captions are built in each of these, using Frappe's own translations. Empty: the system language and the languages your users have chosen."
  },
  {
   "fieldname": "tab_ai",
   "fieldtype": "Tab Break",
   "label": "AI"
  },
  {
   "fieldname": "sb_jev",
   "fieldtype": "Section Break",
   "label": "Ask box",
   "description": "Lets people ask \"how do I…\" in their own words. TypeSafe's Jev picks the walkthrough that answers it - it chooses from your list and never writes text."
  },
  {
   "fieldname": "enable_ask",
   "fieldtype": "Check",
   "label": "Show the Ask box",
   "default": "1"
  },
  {
   "fieldname": "jev_key",
   "fieldtype": "Password",
   "label": "TypeSafe Jev API key"
  },
  {
   "fieldname": "min_confidence",
   "fieldtype": "Float",
   "label": "Play automatically at confidence",
   "default": "0.6",
   "description": "Below this the match is offered as a suggestion."
  },
  {
   "fieldname": "test_jev",
   "fieldtype": "Button",
   "label": "Test the Ask box"
  },
  {
   "fieldname": "sb_writer",
   "fieldtype": "Section Break",
   "label": "Writer (optional)",
   "description": "A language model used only when you press Load: to write one-line summaries and to translate hand-written captions. Never called while people use the desk."
  },
  {
   "fieldname": "writer_provider",
   "fieldtype": "Select",
   "label": "Provider",
   "options": "\nOpenAI\nAzure OpenAI\nAnthropic\nOpenAI-compatible"
  },
  {
   "fieldname": "writer_model",
   "fieldtype": "Data",
   "label": "Model",
   "depends_on": "writer_provider",
   "description": "e.g. gpt-5.6, claude-sonnet-5-5; for Azure the deployment name"
  },
  {
   "fieldname": "writer_api_key",
   "fieldtype": "Password",
   "label": "API key",
   "depends_on": "writer_provider"
  },
  {
   "fieldname": "writer_base_url",
   "fieldtype": "Data",
   "label": "Endpoint",
   "depends_on": "eval:['Azure OpenAI','OpenAI-compatible'].includes(doc.writer_provider)",
   "description": "Azure: https://&lt;resource&gt;.openai.azure.com · OpenAI-compatible: the base URL ending in /v1"
  },
  {
   "fieldname": "cb_writer",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "ai_summaries",
   "fieldtype": "Check",
   "label": "Write summaries",
   "default": "1",
   "depends_on": "writer_provider"
  },
  {
   "fieldname": "ai_translations",
   "fieldtype": "Check",
   "label": "Translate captions",
   "default": "1",
   "depends_on": "writer_provider"
  },
  {
   "fieldname": "test_writer",
   "fieldtype": "Button",
   "label": "Test the writer",
   "depends_on": "writer_provider"
  },
